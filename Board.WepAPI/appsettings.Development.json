{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File",
            "Serilog.Sinks.Debug",
            "Serilog.Exceptions"
        ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "Board.BusinessLogic": "Debug"
            }
        },
        "Enrich": [ "FromLogContext", "WithExceptionDetails" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    // Compact template for console: Time | Level | Message (no stack trace by default)
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}"
                }
            },
            { "Name": "Debug" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-dev-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 2,
                    // Full template for file: includes detailed Exception information
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    }
}